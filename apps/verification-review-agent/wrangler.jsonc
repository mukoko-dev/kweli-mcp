{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-verification-review-agent",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "class_name": "VerificationReviewAgent",
        "name": "VERIFICATION_REVIEW_AGENT",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VerificationReviewAgent"],
    },
  ],

  "routes": [{ "pattern": "kweli-review.nyuchi.dev", "custom_domain": true }],

  "observability": { "enabled": true },

  // Worker Previews: the staging beta (nyuchi/.github#84). Every push to
  // `staging` runs `wrangler preview --name staging` (.github/workflows/beta.yml).
  // Previews inherit NOTHING from the top level, so each binding is repeated
  // here against the SAME production resources (owner rule: no staging data
  // stores). Each Preview gets its own Durable Object namespace automatically.
  // Secrets and the dashboard vars kept by keep_vars come from the Previews
  // Base (`wrangler preview base-config secret put NAME`), not this file.
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "class_name": "VerificationReviewAgent",
          "name": "VERIFICATION_REVIEW_AGENT",
        },
      ],
    },
    "observability": { "enabled": true },
  },
  // workers.dev Preview URLs, so the beta URL serves. Takes effect on the
  // Worker's first production deploy (or the Preview toggle on its Domains tab).
  "preview_urls": true,

  "dev": { "port": 8793 },
}
