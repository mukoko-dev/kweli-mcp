{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-bulk-place-agent",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  // Wrangler deletes every var not listed here on deploy, UNLESS keep_vars is
  // set — so this flag is what makes dashboard-managed configuration durable.
  // Without it, removing a value from `vars` means the next deploy wipes it.
  "keep_vars": true,

  "compatibility_date": "2025-04-01",
  // mongodb driver + the Agents SDK both require the Node.js compat layer.
  "compatibility_flags": ["nodejs_compat"],

  // FundiAgent (per-task executor) is a Cloudflare Agent — a SQLite-backed
  // Durable Object. This worker owns the class + binding; nothing else binds
  // it directly — other callers (the Kweli MCP, or any Nyuchi/Mukoko app)
  // reach this worker only via its public POST /tasks (WorkOS M2M gated).
  "durable_objects": {
    "bindings": [{ "class_name": "FundiAgent", "name": "FUNDI_AGENT" }],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FundiAgent"],
    },
  ],

  // This worker is BOTH producer (POST /tasks, the cron sweeper) and
  // consumer of its own queue — unlike the earlier two-worker split, no
  // other worker needs producer access now that /tasks lives here.
  "queues": {
    "producers": [
      { "queue": "fundi-ingestion-tasks", "binding": "TASK_QUEUE" },
    ],
    "consumers": [
      {
        "queue": "fundi-ingestion-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fundi-ingestion-tasks-dlq",
      },
    ],
  },

  // D1 task ledger — shared with apps/mcp (the Kweli MCP reads it for its
  // task_status/task_records tools). Create with
  // `wrangler d1 create fundi-ingestion-ledger` (already exists in
  // nyuchi/kweli's Cloudflare account — reuse that id).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundi-ingestion-ledger",
      "database_id": "1ca0ed44-20fc-4cd5-a6c1-86b40daf1041",
      "migrations_dir": "migrations",
    },
  ],

  // OSM-id dedupe / rate-limit cache.
  "kv_namespaces": [
    { "binding": "DEDUP_KV", "id": "7e726479ef2048c5b12e51bf1cc25141" },
  ],

  // Workers AI: generate_description routes through the `fundi` AI Gateway
  // (background agents — authenticated, no guardrails, no cache). The binding
  // is pre-authenticated, so no gateway token is stored here.
  "ai": { "binding": "AI" },

  // Hourly sweeper for failed/partial stragglers.
  "triggers": { "crons": ["0 * * * *"] },

  "routes": [{ "pattern": "fundi-bulk.nyuchi.dev", "custom_domain": true }],

  // Traces: Workers tracing plus metadata-only agent spans (src/tracing.ts).
  // Sampling is left at the default of 1 (every request; owner decision
  // 2026-10-04: 100%, metadata only).
  "observability": { "enabled": true, "traces": { "enabled": true } },

  // Keep the mongodb driver's optional native add-ons (.node binaries) out of
  // the esbuild bundle; the driver runs fine without them.
  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js",
  },

  // Build-time constants only. Every WorkOS value is set as an environment
  // variable per Cloudflare environment — see .dev.vars.example.
  "vars": {
    // Direct model: the fallback while the dynamic route below is not
    // configured on the gateway. Qwen3-30B-A3B (MoE, ~3B active) is far cheaper
    // per call than kimi-k2.6 for 2-3 sentences of prose.
    "FUNDI_AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    // Gateway dynamic route; preferred when present on the gateway.
    "FUNDI_AI_ROUTE": "dynamic/places",
    "FUNDI_AI_GATEWAY": "fundi",
    // Max Workers AI requests per UTC day (src/ai-budget.ts), shared with
    // fundi-ingestion through the same D1 table. Each description costs one or
    // two requests (one hedge retry). When spent, places are written without a
    // description and stay re-enrichable.
    "FUNDI_AI_DAILY_BUDGET": "2000",
    "FUNDI_BOUNDARY_BBOX": "-36,-26,38,64",
  },

  "dev": { "port": 8790 },
}
