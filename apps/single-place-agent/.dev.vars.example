# Copy to `.dev.vars` for `wrangler dev` in this directory.
# Never commit the real file.
#
# EVERY WorkOS value below is an environment variable, deliberately NOT a
# literal in wrangler.jsonc. The 10 Aug 2026 issuer migration had to be chased
# through source in repo after repo precisely because these were hardcoded;
# Staging and Production are different WorkOS environments with different
# client IDs, so one baked-in value is wrong for at least one of them.
#
# In deployed environments set these on the Worker (dashboard or
# `wrangler secret put`). `keep_vars: true` in wrangler.jsonc is what stops a
# deploy from deleting them.

# The WorkOS AuthKit issuer. REQUIRED and set per environment — never
# committed, no default in code (1Password nyuchi/workos, field
# WORKOS_AUTHKIT_DOMAIN). Use your environment's AuthKit domain here.
WORKOS_ISSUER="https://<your-authkit-domain>"

# This agent's own M2M application ("Kweli"), distinct from bulk-place-agent's.
# Deliberately NO org restriction: any Nyuchi/Mukoko app holding this pair may
# create a single place. Leave WORKOS_ALLOWED_ORG_IDS unset.
WORKOS_M2M_CLIENT_ID="client_..."

MONGODB_URI="mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority"
